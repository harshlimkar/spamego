# `.gitignore`

```gitignore
# =========================
# Node.js / Frontend
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build folders
dist/
build/
.next/
out/

# Environment variables
.env
.env.*
!.env.example


# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Python build files
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/


# =========================
# Database
# =========================
*.sqlite
*.sqlite3
*.db


# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.iml


# =========================
# Operating System
# =========================
.DS_Store
Thumbs.db
desktop.ini


# =========================
# Logs
# =========================
*.log
logs/


# =========================
# Android / Gradle
# =========================
.gradle/
**/build/
local.properties
*.apk
*.aab


# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.swp
*.swo
```
